# tts-trainer — .env file paired with docker-compose.gpu.prod.yml
# Copy to .env and edit on the GPU host.

# GHCR image tag
TTS_TRAINER_IMAGE_TAG=latest-gpu-flash

# Listen port (host -> container 8009)
TTS_TRAINER_PORT=8009

# MinIO endpoint. Default points at the k8s NodePort exposed at
# 192.168.15.152:30002 (svc minio/svce-minio-api). Override for other
# clusters / mirrors.
MINIO_ENDPOINT=192.168.15.152:30002

# MinIO credentials. The k8s secret minio/s-minio exposes:
#   MINIO_ROOT_USER     -> minio
#   MINIO_ROOT_PASSWORD -> ********
#   MINIO_ACCESS_KEY    -> <rotating, see secret>
#   MINIO_SECRET_KEY    -> <rotating, see secret>
# Use the access/secret pair in production.
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=MinioS3Success

# Bucket the trainer writes datasets / runs / voicepacks under.
MINIO_BUCKET=tts-training

# false: HTTP (NodePort). true: HTTPS.
MINIO_SECURE=false

# Verbosity
TTS_TRAINER_LOG_LEVEL=INFO

# Optional HuggingFace token. Only needed for gated datasets like
# Common Voice. Generate one at https://huggingface.co/settings/tokens
# and accept the dataset terms at
# https://huggingface.co/datasets/mozilla-foundation/common_voice_19_0
# before triggering POST /v1/datasets/download {id:"commonvoice_ptbr"}.
# Public PT-BR alternatives that DO NOT require a token:
#   id="mls_ptbr"    — Multilingual LibriSpeech Portuguese, ~160h.
#   id="fleurs_ptbr" — Google FLEURS pt_br, ~10h (smoke-test scale).
HF_TOKEN=
